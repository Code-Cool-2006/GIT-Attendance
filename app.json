{
  "expo": {
    "name": "GIT-Connect-Admin",
    "slug": "GIT-Connect-Admin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/GIT_Connect_admin_logo.png",
    "scheme": "gitconnectadmin",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rishabchavadar.GITConnectAdmin",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/GIT_Connect_admin_logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.rishabchavadar.GITConnectAdmin",
      "usesCleartextTraffic": true
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/GIT_Connect_admin_logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/GIT_Connect_admin_logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "befba2da-dbac-415e-87d9-5f081d6e907c"
      }
    }
  }
}
